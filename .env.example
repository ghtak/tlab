TLAB_APP_DATABASE__URL=postgres://tlab:tlab_dev@127.0.0.1:5432/tlab
# Web cookies use HTTPS by default; set the exact external origin (no trailing /).
# TLAB_APP_AUTH__WEB__ORIGIN=https://localhost:8081
# Explicit local HTTP development only (separate development cookie names):
# TLAB_APP_AUTH__WEB__ORIGIN=http://localhost:8080
# TLAB_APP_AUTH__WEB__ALLOW_INSECURE_HTTP=true

# Google OAuth settings; separate multiple redirect URIs with commas.
TLAB_APP_AUTH__GOOGLE_OAUTH2__CLIENT_ID=
TLAB_APP_AUTH__GOOGLE_OAUTH2__CLIENT_SECRET=
TLAB_APP_AUTH__GOOGLE_OAUTH2__AUTH_URI=
TLAB_APP_AUTH__GOOGLE_OAUTH2__TOKEN_URI=
TLAB_APP_AUTH__GOOGLE_OAUTH2__REDIRECT_URIS=
